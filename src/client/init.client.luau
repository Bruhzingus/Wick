--!strict
-- Client boot: pure wiring. Starts each controller once; no logic lives here.

local CameraController = require(script.CameraController)
local CandleLightController = require(script.CandleLightController)
local AudioCues = require(script.AudioCues)
local AmbientCaveDirector = require(script.AmbientCaveDirector)
local AmbientRockfallController = require(script.AmbientRockfallController)
local AmbientWaterDripController = require(script.AmbientWaterDripController)
local CursorController = require(script.CursorController)
local DialController = require(script.DialController)
local DripstoneController = require(script.DripstoneController)
local ElevatorController = require(script.ElevatorController)
local DescentLadderController = require(script.DescentLadderController)
local LanternPresentation = require(script.LanternPresentation)
local EnvironmentAnimationController = require(script.EnvironmentAnimationController)
local FeelController = require(script.FeelController)
local HotbarController = require(script.HotbarController)
local HintController = require(script.HintController)
local MusicController = require(script.MusicController)
local TouchControls = require(script.TouchControls)
local ToolController = require(script.ToolController)
local DynamiteController = require(script.DynamiteController)
local MiningController = require(script.MiningController)
local WaxBar = require(script.WaxBar)
local BasinPrompt = require(script.BasinPrompt)
local ResultsText = require(script.ResultsText)
local RelightPromptController = require(script.RelightPromptController)
local LampNetworkController = require(script.LampNetworkController)
local LobbyController = require(script.LobbyController)
local PartyPanelController = require(script.PartyPanelController)
local UpdateLogController = require(script.UpdateLogController)
local SettingsController = require(script.SettingsController)
local ShopController = require(script.ShopController)
local SpectatorController = require(script.SpectatorController)
local CaveAcousticsController = require(script.CaveAcousticsController)
local FootstepController = require(script.FootstepController)
local SprintFeedbackController = require(script.SprintFeedbackController)
local ThreatVisualController = require(script.ThreatVisualController)
local AshamedLurkerController = require(script.AshamedLurkerController)
local StoneWardenController = require(script.StoneWardenController)
local DevDiagnosticsController = require(script.DevDiagnosticsController)
local DevTestRoomController = require(script.DevTestRoomController)

AudioCues.start()
-- BEFORE any controller that registers an action button. TouchControls builds the cluster the tools,
-- dynamite, the bell and mining all place themselves into; a registration that arrives before the
-- rows exist has nowhere to go.
TouchControls.start()
AmbientRockfallController.start()
AmbientWaterDripController.start()
AmbientCaveDirector.start()
CursorController.start()
CandleLightController.start()
CameraController.start()
DialController.start()
DripstoneController.start()
ElevatorController.start()
DescentLadderController.start()
LanternPresentation.start()
EnvironmentAnimationController.start()
FeelController.start()
SpectatorController.start()
CaveAcousticsController.start()
FootstepController.start()
SprintFeedbackController.start()
ThreatVisualController.start()
AshamedLurkerController.start()
StoneWardenController.start()
ToolController.start()
DynamiteController.start()
MiningController.start()
HotbarController.start()
HintController.start()
WaxBar.start()
BasinPrompt.start()
ResultsText.start()
RelightPromptController.start()
LampNetworkController.start()
PartyPanelController.start()
UpdateLogController.start()
LobbyController.start()
ShopController.start()
MusicController.start()
SettingsController.start()

-- The test room is optional developer tooling and cannot be allowed to interrupt the main client
-- boot if its keypad presentation ever regresses.
task.spawn(function()
	local ok, message = pcall(DevTestRoomController.start)
	if not ok then
		warn("[WICK] Developer test room failed to start: " .. tostring(message))
	end
end)

-- Developer diagnostics are optional tooling, not part of the gameplay boot dependency chain.
-- Start them only after every core controller has connected, and contain any diagnostics-specific
-- runtime failure so it can never suppress the party panel or other lobby UI again.
task.spawn(function()
	local ok, message = pcall(DevDiagnosticsController.start)
	if not ok then
		warn("[WICK] Developer diagnostics failed to start: " .. tostring(message))
	end
end)
